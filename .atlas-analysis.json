  "keyFeatures": [
    "Real-time pump ON/OFF control with large tactile pill switch",
    "Emergency stop action with immediate hardware response",
    "Equipment status hero card with live operational state",
    "Outdoor-optimized UI with high contrast and gloved-thumb accessibility",
    "Real-time metrics monitoring and threshold alerting",
    "Operational history and audit logging",
    "Multi-pump management from a single dashboard",
    "Configurable alert thresholds and notification channels"
  ],
  "publicApiSurface": [
    "GET /api/pumps — list all pumps and their current status",
    "POST /api/pumps/{id}/control — send ON/OFF command to a pump",
    "POST /api/pumps/{id}/emergency-stop — trigger emergency stop",
    "GET /api/pumps/{id}/metrics — retrieve real-time metrics",
    "GET /api/alerts — list active alerts",
    "PUT /api/configuration/thresholds — update operational thresholds"
  ]
